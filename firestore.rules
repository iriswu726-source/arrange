rules_version = '2';

// ARTALE 背包整理：隊伍共用規則
// - 只有隊伍成員能讀寫隊伍的資料
// - 知道邀請碼（隊伍 ID）的登入者可以把「自己」加入隊伍
// - 隊長可以移除成員；成員可以自己退出
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMember(teamId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members;
    }

    match /teams/{teamId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.memberInfo is map
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;

      allow update: if signedIn()
        && request.resource.data.owner == resource.data.owner
        && (
          // 加入：只能把自己加進成員、只能改自己的成員資料
          (!(request.auth.uid in resource.data.members)
            && request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo'])
            && request.resource.data.memberInfo.diff(resource.data.memberInfo).affectedKeys().hasOnly([request.auth.uid]))
          ||
          // 成員：改隊名等（成員名單不變）
          (request.auth.uid in resource.data.members
            && request.resource.data.members == resource.data.members
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 40)
          ||
          // 自己退出
          (request.auth.uid in resource.data.members
            && request.auth.uid != resource.data.owner
            && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo']))
          ||
          // 隊長移除成員
          (request.auth.uid == resource.data.owner
            && request.auth.uid in request.resource.data.members
            && resource.data.members.toSet().hasAll(request.resource.data.members.toSet())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo']))
        );

      allow delete: if signedIn() && request.auth.uid == resource.data.owner;

      // 角色、圖示、數字模板
      match /{coll}/{docId} {
        allow read, write: if isMember(teamId) && coll in ['characters', 'icons', 'meta'];
      }
    }
  }
}
